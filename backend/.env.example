# =============================================================================
# Darbak Backend — Environment Variables
# Copy this file to `backend/.env` and fill in real values.
# DO NOT commit `.env` to git. The .gitignore already excludes it.
# Full storage setup: docs/MINIO_S3_SETUP.md
# =============================================================================

# --- HTTP Server ----------------------------------------------------------
PORT=5000

# --- MySQL (XAMPP / MariaDB / MySQL Server) -------------------------------
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=darbak_db
MYSQL_PORT=3306

# Optional override: when set, DB_HOST takes precedence over MYSQL_HOST.
# DB_HOST=localhost

# --- Security: JWT & AES-256-CBC encryption -------------------------------
# Generate strong random values for production. The backend will refuse to
# start the encryption module if these are missing in production-like envs.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # ENCRYPTION_KEY (64 hex chars)
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"   # ENCRYPTION_IV  (32 hex chars)
JWT_SECRET=change_me_to_a_long_random_string
ENCRYPTION_KEY=change_me_64_hex_chars_for_AES_256
ENCRYPTION_IV=change_me_32_hex_chars_for_AES_IV

# --- Firebase Admin (FCM push + Email/Password auth bridge) ---------------
# Download a JSON key from:
#   Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Save it OUTSIDE the repo (recommended) or under backend/ (it is gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./path-to-your-service-account.json

# Web API Key (Firebase Console -> Project Settings -> General -> Web API Key)
# Required only for POST /api/auth/password-reset-request (sendOobCode).
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY

# --- Email (Gmail SMTP via App Password) ----------------------------------
# Optional. Used for outbound email flows when enabled.
# Create at: https://myaccount.google.com/apppasswords
# GMAIL_USER=youraccount@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- MinIO / S3-compatible Object Storage ---------------------------------
# Quick start: from project root run:
#     docker compose up -d minio
#     docker compose run --rm minio_init
#
# IMPORTANT: MINIO_ENDPOINT must point to the S3 API port (9190 in our compose),
# NEVER the web console port (9191). See docs/MINIO_S3_SETUP.md for details.
MINIO_ENDPOINT=127.0.0.1:9190
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=darbak-uploads
MINIO_USE_SSL=false

# Presigned URL host: must be reachable from the *client device*.
# - Same machine only:        http://127.0.0.1:9190
# - Phone/emulator on LAN:    http://YOUR_LAN_IPv4:9190
MINIO_EXTERNAL_URL=http://127.0.0.1:9190

# --- Cron jobs ------------------------------------------------------------
# Set to "1" to disable the daily late-delivery penalty sweep (cron 0 2 * * *).
# DISABLE_DELIVERY_PENALTY_CRON=0
