{
  "name": "darbak-backend",
  "version": "1.0.0",
  "description": "Backend API for Darbak logistics app",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --runInBand --testPathPattern='tests/unit'",
    "test:integration": "jest --runInBand --testPathPattern='tests/integration'",
    "test:socket": "jest --runInBand --testPathPattern='tests/socket'",
    "test:coverage": "jest --runInBand --coverage",
    "test:ci": "jest --runInBand --coverage --ci",
    "test:report": "node ../tool/generate_test_report.js",
    "test:report:fast": "node ../tool/generate_test_report.js --skip-run",
    "lint:tests": "node -e \"require('jest/package.json')\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1039.0",
    "@aws-sdk/s3-request-presigner": "^3.1039.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.6.0",
    "node-cron": "^3.0.3",
    "puppeteer": "^24.42.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0"
  }
}
