# ============================================================================
# Darbak — Root .gitignore
# Covers Flutter app, Node.js backend, Playwright E2E, Docker, IDE, OS, logs.
# ============================================================================

# --- OS / Editor ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.bak
*.orig
*.rej

# --- IDEs ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.history/
.fleet/

# --- Logs / Crash Dumps ---
*.log
hs_err_pid*.log
replay_pid*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
test_out.txt

# ============================================================================
# Flutter / Dart
# ============================================================================
.atom/
.build/
.buildlog/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
migrate_working_dir/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android Studio build outputs
/android/app/debug
/android/app/profile
/android/app/release
*.class

# Python
*.pyc

# ============================================================================
# Node.js / Backend
# ============================================================================
node_modules/
backend/node_modules/
backend/coverage/
backend/.env
backend/.env.*.local
.env
.env.local
.env.*.local

# Firebase service account (NEVER commit)
backend/firebase-service-account.json
backend/*firebase-adminsdk*.json
.firebase/

# Local file uploads from the backend (user-generated content)
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/epod/
backend/uploads/epod/*
!backend/uploads/epod/.gitkeep

# ============================================================================
# QA / Test reports (regenerated)
# ============================================================================
.tmp-qa-report/
docs/test-report/

# ============================================================================
# Playwright E2E (e2e/admin-dashboard)
# ============================================================================
e2e/**/node_modules/
e2e/**/playwright-report/
e2e/**/test-results/
e2e/**/.playwright/
e2e/**/playwright/.cache/
e2e/**/blob-report/

# ============================================================================
# Misc
# ============================================================================
*.tgz
*.zip
*.7z
